APP_NAME=RepSense API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://repsense:repsense_dev_password@localhost:5432/repsense
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-use
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Phase 4 worker and tracing
REDIS_URL=redis://localhost:6379/0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
